{
  "name": "fire-safety-records-backend",
  "version": "1.0.0",
  "description": "Express + PostgreSQL API for workplace fire safety records (Scotland)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.mjs",
    "seed:clear": "node scripts/seed.mjs --clear",
    "auth:init": "node scripts/auth-setup.mjs",
    "auth:user": "node scripts/auth-setup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:watch": "node --test --watch --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
