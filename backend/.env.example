# Database ------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the session pooler unless you are on an IPv6 network. Any other Postgres
# instance works too; SSL is enabled automatically unless the host is localhost.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Largest number of database connections this process holds open. Supabase's
# pooler caps the clients a project may have, so keep the total across all
# running instances under that cap.
PG_POOL_MAX=10

PORT=3001
NODE_ENV=development

# Authentication ------------------------------------------------------------
# REQUIRED in production; at least 32 characters. Outside production a random
# key is generated at startup, which means restarting invalidates outstanding
# tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long an access token lives. Short, because it is a snapshot: keep it in
# the tens of minutes rather than hours.
ACCESS_TOKEN_TTL=15m

# How long a refresh token lives before the user must sign in again.
REFRESH_TOKEN_DAYS=30

# scrypt cost (the N parameter). 65536 is the OWASP minimum for r=8, p=1 and
# costs roughly 100ms per hash. Raise it as hardware improves: existing hashes
# stay valid and are upgraded at the owner's next sign-in.
SCRYPT_COST=65536

# Sign-in attempts before an account is locked, and for how long.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Refresh cookies are always Secure in production. Set this to true when
# running behind TLS outside production; leave it unset for plain-HTTP local
# development, where a Secure cookie would never be sent.
# SECURE_COOKIES=true

# Browser origins allowed to call the API with credentials. An allowlist, not a
# wildcard — name every origin that needs access.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limits ---------------------------------------------------------------
# Sign-in attempts per address per 15 minutes, and requests per caller per
# minute across the rest of the API.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=300
