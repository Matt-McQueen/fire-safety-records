# Database ------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the session pooler unless you are on an IPv6 network. Any other Postgres
# instance works too; SSL is enabled automatically unless the host is localhost.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Largest number of database connections this process holds open. Supabase's
# pooler caps the clients a project may have, so keep the total across all
# running instances under that cap.
PG_POOL_MAX=10

PORT=3001
NODE_ENV=development

# Names this deployment in /api/health ("production", "staging"), so a test
# run can confirm which environment answered. Defaults to NODE_ENV, which is
# not enough on its own: staging also runs with NODE_ENV=production.
# APP_ENVIRONMENT=staging

# The commit this build was made from, reported by /api/health so a deploy
# check can wait for the new build rather than testing the old one. Render
# (RENDER_GIT_COMMIT) and Vercel (VERCEL_GIT_COMMIT_SHA) inject it themselves;
# set this only where the platform does not.
# GIT_COMMIT=

# Databases the writing test suites must refuse to run against, as a
# comma-separated list of hostnames (matched exactly or as a suffix). Put the
# production host here. backend/tests and e2e/ both create and delete records
# in whatever DATABASE_URL names, which is safe against a disposable database
# and not safe against a live one; smoke/ is the suite for a live environment.
# PROTECTED_DATABASE_HOSTS=aws-1-eu-west-1.pooler.supabase.com

# Authentication ------------------------------------------------------------
# REQUIRED in production; at least 32 characters. Outside production a random
# key is generated at startup, which means restarting invalidates outstanding
# tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long an access token lives. Short, because it is a snapshot: keep it in
# the tens of minutes rather than hours.
ACCESS_TOKEN_TTL=15m

# How long a refresh token lives before the user must sign in again.
REFRESH_TOKEN_DAYS=30

# scrypt cost (the N parameter). 65536 is the OWASP minimum for r=8, p=1 and
# costs roughly 100ms per hash. Raise it as hardware improves: existing hashes
# stay valid and are upgraded at the owner's next sign-in.
#
# Mind the memory as well as the CPU. Each hash in flight needs about
# 128 * N * r bytes, so N=65536 is 64 MiB per concurrent sign-in and nothing
# here caps how many run at once — the login rate limit is per address, not
# global. On a small instance that is a way to run out of memory: 512 MB holds
# roughly six. Lower N on constrained hosts (16384 costs 16 MiB), and treat
# anything below 65536 as a concession to the hardware rather than a setting
# you would choose.
SCRYPT_COST=65536

# Sign-in attempts before an account is locked, and for how long.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Refresh cookies are always Secure in production. Set this to true when
# running behind TLS outside production; leave it unset for plain-HTTP local
# development, where a Secure cookie would never be sent.
# SECURE_COOKIES=true

# Browser origins allowed to call the API with credentials. An allowlist, not a
# wildcard — name every origin that needs access.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limits ---------------------------------------------------------------
# Sign-in attempts per address per 15 minutes, and requests per caller per
# minute across the rest of the API.
RATE_LIMIT_LOGIN=10
# Refresh attempts per address per 15 minutes. Every full page load calls
# /api/auth/refresh once (the access token lives only in memory, so a reload
# has nothing else to check a session with) - a browser-driven test suite
# with enough full navigations across enough test files can add up to more of
# these than a human ever would, and hit this before it hits anything else.
RATE_LIMIT_REFRESH=60
RATE_LIMIT_API=300
