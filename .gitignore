node_modules/

# Every environment file, not just the bare one. `.env` alone left
# `.env.staging`, `.env.local`, `.env.production` and anything else of that
# shape committable, and this repository is public — a connection string put in
# one of them while testing against a deployment would have been published.
# The example is the one that is meant to be in here, so it is named back in.
.env
.env.*
!.env.example
.claude/scheduled_tasks.lock
dist/
*.log
*.tsbuildinfo
coverage/
e2e/.auth/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# Database dumps, if BACKUP_DIR is ever pointed inside the checkout. It should
# not be - see backend/scripts/backup.mjs - and this is the second line of
# defence, because this repository is public.
backups/
*.dump
*.dump.enc
